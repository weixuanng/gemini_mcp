# Copy to .env for local runs (never commit .env). See README "Configuration" for all options.
GEMINI_API_KEY=
GEMINI_TIER=free
# Required for the HTTP server; generate with: openssl rand -base64 32
MCP_ACCESS_KEY=
# Optional standing context Gemini should always know about you
# GEMINI_USER_CONTEXT=I live in Singapore and prefer metric units.
